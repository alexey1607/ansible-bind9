// {{ ansible_managed }}

acl trusted {
{% for network in acl %}
    {{ network }};
{% endfor %}
};

options {

    directory "{{ cache_directory }}";

    recursion {{ recursion }};
    allow-recursion { trusted; };

    allow-query {
        localhost;
        trusted; 
    };

    forwarders {
    {% for forwarder in forwarders %}
        {{ forwarder }};
    {% endfor %}
    };

    allow-transfer {
    {% for host in groups['dns'] %}
    {% if hostvars[host]['dns_role'] == 'slave' %}
        {{ hostvars[host]['ansible_default_ipv4']['address'] }};
    {% endif %}
    {% endfor %}
    };

{% if dnssec_enable %}
    dnssec-enable yes;
    dnssec-validation no;
{% endif %}

{% if rate_limit_enabled %}
    rate-limit {
        responses-per-second {{ rate_limit_responses_per_second }};
        window {{ rate_limit_window }};
    };
{% endif %}

    auth-nxdomain no;    # conform to RFC1035

    listen-on { any; };

    listen-on-v6 { any; };
    
};
